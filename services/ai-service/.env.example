# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
#   cp .env.example .env

# The model credential. The service starts without it, reports NOT_SERVING,
# and fails every call with FAILED_PRECONDITION.
AI_SERVICE_API_KEY=

# Defaults, shown so they are discoverable. Delete any line you do not change.
# AI_SERVICE_PORT=50051
# AI_SERVICE_MAX_WORKERS=10
# AI_SERVICE_PROVIDER=anthropic
# AI_SERVICE_MODEL=claude-haiku-4-5-20251001
# AI_SERVICE_MAX_TOKENS=4096
# AI_SERVICE_REQUEST_TIMEOUT_S=60
# AI_SERVICE_SHUTDOWN_GRACE_S=30
# AI_SERVICE_ENABLE_REFLECTION=true
